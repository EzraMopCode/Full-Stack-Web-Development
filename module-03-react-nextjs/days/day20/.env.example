# Environment Configuration Example for Addis Eats
# Copy this file to .env.local and populate the secrets.
# IMPORTANT: Never commit .env.local or prefix server secrets with NEXT_PUBLIC_

ORDER_SECRET_KEY=your_order_secret_key_here_at_least_32_chars
AUTH_SECRET=your_auth_secret_jwt_key_here_at_least_32_chars
NEXT_PUBLIC_APP_NAME=Addis Eats
NEXT_PUBLIC_API_URL=http://localhost:3000
